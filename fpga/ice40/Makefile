# iCE40 / TinyFPGA BX.
# Dev shell: `nix develop .#ice40` (yosys, nextpnr-ice40, icestorm, tinyprog, vpr).
#
# Default target builds the Tiny Tapeout harness (tt_top.v + the DSLX core from
# the repo root) with the icestorm flow and `make upload` flashes it over USB:
#   yosys synth_ice40 -> nextpnr-ice40 -> icepack -> tinyprog
# The VPR architecture model (milestone 1) keeps its own targets below.

TOP=top
PCF=tinyfpga_bx.pcf
REPO_ROOT:=$(abspath ../..)
SOURCES?=tt_top.v $(REPO_ROOT)/src/project.sv $(REPO_ROOT)/src/top.sv

all: build/$(TOP).bin

# src/ at the repo root is generated by the XLS flow.
$(REPO_ROOT)/src/top.sv $(REPO_ROOT)/src/project.sv:
	$(error $@ missing -- run `nix develop -c make` at the repo root to generate src/ from the DSLX sources)

build/$(TOP).json: $(SOURCES)
	mkdir -p build
	yosys -q -l build/synth.log -p "read_verilog -sv $(SOURCES); synth_ice40 -top $(TOP) -json $@"

build/$(TOP).asc: build/$(TOP).json $(PCF)
	nextpnr-ice40 --lp8k --package cm81 --freq 16 --pcf $(PCF) --json $< --asc $@ -q -l build/pnr.log

build/$(TOP).bin: build/$(TOP).asc
	icepack $< $@

upload: build/$(TOP).bin
	tinyprog -p $<

# ---- VPR architecture model (milestone 1, approximate routing) ----

CHIPDB?=$(ICESTORM)/share/icebox/chipdb-8k.txt
TIMINGS?=$(ICESTORM)/share/icebox/timings_lp8k.txt

# Guard here rather than at parse time so `clean` still works outside the shell.
arch.xml: template.xml scripts/chipdb_layout.py scripts/chipdb_timing.py
	@test -n "$(ICESTORM)" || { echo "ICESTORM is not set -- enter the dev shell first: nix develop .#ice40" >&2; exit 1; }
	python3 scripts/chipdb_layout.py --chipdb $(CHIPDB) --template template.xml --output arch.tmp.xml
	python3 scripts/chipdb_timing.py --timings $(TIMINGS) --input arch.tmp.xml --output $@ --report timing-report.txt
	rm -f arch.tmp.xml

counter.blif: counter.v
	yosys -q -p "read_verilog counter.v; synth -flatten -lut 4; opt_clean; write_blif $@"

# The milestone-1 referee: pack, place and route the counter on the model.
run: arch.xml counter.blif
	vpr arch.xml counter.blif --route_chan_width 100 --clock_modeling route

check: arch.xml
	python3 -c "import xml.etree.ElementTree as ET; ET.parse('arch.xml'); print('arch.xml: well-formed XML')"

clean:
	rm -rf build
	rm -f arch.xml arch.tmp.xml timing-report.txt counter.blif
	rm -f *.net *.net.post_routing *.place *.route vpr_stdout.log *.rpt packing_pin_util.rpt pre_pack.report_timing.setup.rpt

.PHONY: all upload run check clean
